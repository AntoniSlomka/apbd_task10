@using apbdtask10_v2.DTOs
@model List<AppUserDTO>

<div class="text-center">
    <h2 class="display-5">App Users List:</h2>

    @if (Model.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Username</th>
                    <th>Number of Notes</th>
                    <th>Creation Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.NoteCout</td>
                        <td>@u.CreatedAt</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No users in the system</p>
    }

</div>
